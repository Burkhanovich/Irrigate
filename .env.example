# ══════════════════════════════════════════════
# IrriGate — Production Environment Variables
# ══════════════════════════════════════════════
# Bu faylni .env nomiga nusxalang va o'zgartiring:
#   cp .env.example .env

# Django
SECRET_KEY=CHANGE-THIS-TO-A-RANDOM-50-CHAR-STRING
DEBUG=False
ALLOWED_HOSTS=your-server-ip,your-domain.com
DJANGO_SETTINGS_MODULE=config.settings.production

# SSL (agar nginx + certbot bilan HTTPS bo'lsa True qiling)
SECURE_SSL_REDIRECT=False

# Ma'lumotlar bazasi (Docker ichida o'zgartirilmasin)
DATABASE_URL=postgres://irrigate_user:irrigate_pass@db:5432/irrigate_db

# Redis (Docker ichida o'zgartirilmasin)
REDIS_URL=redis://redis:6379/0

# MQTT
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=irrigate_mqtt
MQTT_PASSWORD=mqtt_secure_password

# Email (ixtiyoriy)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
